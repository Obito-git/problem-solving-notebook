---
type Props = {
  level: 1 | 2 | 3 | 4 | 5 | 6;
  id: string;
  class?: string;
};

const { level, id, ...rest } = Astro.props as Props;
const Heading = `h${level}` as "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
---

<Heading id={id} {...rest}>
  <slot />
  <a
    class="heading-permalink"
    href={`#${id}`}
    aria-label="Copy link to this section"
    title="Copy link to this section"
  >
    #
  </a>
</Heading>
