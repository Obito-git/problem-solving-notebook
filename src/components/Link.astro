---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
  class?: string;
};

const { href, external, underline = true, class: className, ...rest } =
  Astro.props as Props;
---

<a
  href={href}
  target={external ? "_blank" : "_self"}
  rel={external ? "noopener noreferrer" : undefined}
  class={cn(
    "inline-block text-current transition-colors duration-200 ease-out hover:text-black dark:hover:text-white",
    underline && "underline decoration-black/15 underline-offset-2 hover:decoration-black/25 dark:decoration-white/30 dark:hover:decoration-white/50",
    className,
  )}
  {...rest}
>
  <slot />
</a>
