---
type Props = {
  label: string;
  value: number;
  href?: string;
};

const { label, value, href } = Astro.props as Props;
---

{
  href ? (
    <a
      href={href}
      class="block rounded-lg border border-black/15 p-4 transition-colors hover:bg-black/5 hover:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white"
    >
      <div class="text-2xl font-semibold text-black dark:text-white">{value}</div>
      <div class="text-sm">{label}</div>
    </a>
  ) : (
    <div class="rounded-lg border border-black/15 p-4 dark:border-white/20">
      <div class="text-2xl font-semibold text-black dark:text-white">{value}</div>
      <div class="text-sm">{label}</div>
    </div>
  )
}
