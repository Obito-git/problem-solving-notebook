---
type Props = {
  label: string;
  value: number;
  href?: string;
};

const { label, value, href } = Astro.props as Props;
---

{
  href ? (
    <a
      href={href}
      class="block rounded-lg border border-stone-300 bg-stone-50 p-4 shadow-sm transition-all duration-200 hover:-translate-y-px hover:border-stone-500 hover:shadow-md dark:border-stone-700 dark:bg-stone-900/40 dark:hover:border-stone-500"
    >
      <div class="font-mono text-2xl font-semibold tracking-tight text-stone-950 dark:text-stone-50">{value}</div>
      <div class="mt-1 text-sm text-stone-500 dark:text-stone-400">{label}</div>
    </a>
  ) : (
    <div class="rounded-lg border border-stone-300 bg-stone-50 p-4 shadow-sm dark:border-stone-700 dark:bg-stone-900/40">
      <div class="font-mono text-2xl font-semibold tracking-tight text-stone-950 dark:text-stone-50">{value}</div>
      <div class="mt-1 text-sm text-stone-500 dark:text-stone-400">{label}</div>
    </div>
  )
}
