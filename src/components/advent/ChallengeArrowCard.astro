---
import type { AdventCardEntry } from "@types";
import ArrowLink from "@components/ArrowLink.astro";

type Props = {
  entry: AdventCardEntry;
};

const { entry } = Astro.props;
---

<ArrowLink href={entry.url}>
  <span class="flex items-center gap-3">
    <span class="font-mono text-xs font-medium text-stone-500 dark:text-stone-400">
      Day {String(entry.day).padStart(2, "0")}
    </span>
    <span>{entry.title}</span>
  </span>
</ArrowLink>
