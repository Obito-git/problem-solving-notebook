---
type Props = {
  href: string;
};

const { href } = Astro.props as Props;
---

<a
  href={href}
  class="group inline-flex items-center gap-2 text-sm font-medium text-stone-500 transition-colors duration-200 hover:text-stone-950 dark:text-stone-400 dark:hover:text-stone-50"
>
  <span class="transition-transform duration-200 group-hover:-translate-x-1" aria-hidden="true">←</span>
  <slot />
</a>
