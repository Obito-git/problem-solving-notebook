---
import { cn } from "@lib/utils";

type Props = {
  size?: "content" | "wide";
  class?: string;
};

const { size = "content", class: className, ...rest } = Astro.props as Props;
---

<div
  class={cn(
    "mx-auto w-full px-5 sm:px-8",
    size === "wide" ? "max-w-6xl" : "max-w-3xl",
    className,
  )}
  {...rest}
>
  <slot />
</div>
