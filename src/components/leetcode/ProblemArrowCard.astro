---
import type { ProblemCardEntry } from "@types";
import ArrowLink from "@components/ArrowLink.astro";

type Props = {
  entry: ProblemCardEntry;
};

const { entry } = Astro.props;
---

<ArrowLink href={entry.url} class="py-3">
  <span class="flex items-center gap-3">
    <span>{entry.title}</span>
    <span
      class={`rounded-full border px-2 py-0.5 font-mono text-[0.65rem] font-semibold uppercase tracking-wide ${
        entry.difficulty === "Easy"
          ? "border-emerald-300 bg-emerald-50 text-emerald-800 dark:border-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-300"
        : entry.difficulty === "Medium"
            ? "border-amber-300 bg-amber-50 text-amber-800 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-300"
            : "border-rose-300 bg-rose-50 text-rose-800 dark:border-rose-900 dark:bg-rose-950/40 dark:text-rose-300"
      }`}
    >
      {entry.difficulty}
    </span>
  </span>
</ArrowLink>
