---
import AnchorHeading from "@components/AnchorHeading.astro";
import Link from "@components/Link.astro";

type Props = {
    num: number;
    title: string;
    category: string;
    subcategories: string[];
    difficulty: string;
    url: string;
};

const { num, title, category, subcategories, difficulty, url } = Astro.props as Props;
---

<section class="animate my-8 border-b border-stone-200 pb-8 dark:border-stone-800">
    <p class="font-mono text-xs font-medium uppercase tracking-[0.16em] text-stone-500 dark:text-stone-400">
        LeetCode / {difficulty}
    </p>
    <AnchorHeading level={1} id={`problem-${num}`} class="mt-3 text-3xl tracking-tight sm:text-4xl">
        {num}. {title}
    </AnchorHeading>
    <dl class="mt-6 grid gap-4 text-sm sm:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
        <div>
            <dt class="font-mono text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-stone-500 dark:text-stone-400">Topic</dt>
            <dd class="mt-1 font-medium text-stone-900 dark:text-stone-100">{category}</dd>
        </div>
        <div>
            <dt class="font-mono text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-stone-500 dark:text-stone-400">Patterns</dt>
            <dd class="mt-1 text-stone-700 dark:text-stone-300">{subcategories.join(", ")}</dd>
        </div>
    </dl>
    <Link href={url} external class="mt-6 text-sm font-medium">
        Open problem on LeetCode <span aria-hidden="true">↗</span>
    </Link>
</section>
