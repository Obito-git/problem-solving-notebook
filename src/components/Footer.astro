---
import Container from "@components/Container.astro";
import { SITE } from "@const/global";
import BackToTop from "@components/BackToTop.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <Container size="wide">
    <div class="flex flex-wrap items-end justify-between gap-6 py-8 text-sm">
      <div class="space-y-1">
        <p class="font-mono text-xs font-semibold tracking-[0.2em] text-stone-900 dark:text-stone-100">
          KERNOX / NOTEBOOK
        </p>
        <p>&copy; {year} {SITE.name}. Static notes for persistent patterns.</p>
      </div>
      <div class="flex flex-wrap items-center justify-end gap-3">
        <BackToTop />
        <div
          class="inline-flex overflow-hidden rounded-md border border-stone-300 dark:border-stone-700"
          role="group"
          aria-label="Theme preference"
        >
        <button
          id="light-theme-button"
          type="button"
          aria-label="Light theme"
          class="px-3 py-1.5 text-xs font-medium text-stone-600 transition-colors hover:bg-stone-100 hover:text-stone-950 dark:text-stone-400 dark:hover:bg-stone-800 dark:hover:text-stone-50"
        >
          Light
        </button>
        <button
          id="dark-theme-button"
          type="button"
          aria-label="Dark theme"
          class="border-x border-stone-300 px-3 py-1.5 text-xs font-medium text-stone-600 transition-colors hover:bg-stone-100 hover:text-stone-950 dark:border-stone-700 dark:text-stone-400 dark:hover:bg-stone-800 dark:hover:text-stone-50"
        >
          Dark
        </button>
        <button
          id="system-theme-button"
          type="button"
          aria-label="System theme"
          class="px-3 py-1.5 text-xs font-medium text-stone-600 transition-colors hover:bg-stone-100 hover:text-stone-950 dark:text-stone-400 dark:hover:bg-stone-800 dark:hover:text-stone-50"
        >
          System
        </button>
        </div>
      </div>
    </div>
  </Container>
</footer>
