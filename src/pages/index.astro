---
import { getCollection } from "astro:content";
import AnchorHeading from "@components/AnchorHeading.astro";
import ArrowLink from "@components/ArrowLink.astro";
import Container from "@components/Container.astro";
import StatCard from "@components/StatCard.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { ContentCollection, PAGE_METADATA } from "@const/global";
import { ProblemCategory, ProblemDifficulty } from "@const/leetcode";

const solvedProblems = (await getCollection(ContentCollection.LEETCODE)).filter(
    (problem) => !problem.data.draft,
);
const adventChallenges = (await getCollection(ContentCollection.ADVENT)).filter(
    (challenge) => !challenge.data.draft,
);
const documentedCount = solvedProblems.length + adventChallenges.length;
const categories = Object.values(ProblemCategory)
    .map((category) => ({
        name: category,
        count: solvedProblems.filter((problem) => problem.data.category === category).length,
    }))
    .filter((category) => category.count > 0);
const difficultyCounts = Object.values(ProblemDifficulty)
    .map((difficulty) => ({
        name: difficulty,
        count: solvedProblems.filter((problem) => problem.data.difficulty === difficulty).length,
    }))
    .filter((difficulty) => difficulty.count > 0);
const adventYears = [...new Set(adventChallenges.map((challenge) => challenge.data.year))]
    .sort((left, right) => right - left)
    .map((year) => ({
        year,
        count: adventChallenges.filter((challenge) => challenge.data.year === year).length,
    }));
---

<PageLayout
    title={PAGE_METADATA.home.title}
    description={PAGE_METADATA.home.description}
>
    <Container size="wide">
        <div class="space-y-16">
            <section class="animate max-w-2xl space-y-4">
                <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-stone-500 dark:text-stone-400">
                    Personal / reference notebook
                </p>
                <AnchorHeading level={1} id="problem-solving-notes" class="text-4xl font-semibold tracking-tight text-stone-950 dark:text-stone-50">
                    Problem-solving notes
                </AnchorHeading>
                <p class="font-serif text-lg leading-8">
                    LeetCode and Advent of Code solutions, focused on tests,
                    trade-offs, diagrams, and the reasoning behind each
                    implementation. Most notes use Rust.
                </p>
            </section>

            <section class="animate space-y-6">
                <AnchorHeading level={2} id="snapshot" class="text-xl font-semibold text-stone-950 dark:text-stone-50">
                    Snapshot
                </AnchorHeading>
                <div class="grid gap-3 sm:grid-cols-3">
                    <StatCard label="documented notes" value={documentedCount} />
                    <StatCard href={PAGE_METADATA.leetcode.url} label="LeetCode solved" value={solvedProblems.length} />
                    <StatCard href={PAGE_METADATA.advent.url} label="Advent notes" value={adventChallenges.length} />
                </div>
            </section>

            <section class="animate space-y-6">
                <AnchorHeading level={2} id="collections" class="text-xl font-semibold text-stone-950 dark:text-stone-50">
                    Collections
                </AnchorHeading>
                <ul class="grid gap-3 lg:grid-cols-2">
                    <li>
                        <ArrowLink href={PAGE_METADATA.leetcode.url} class="py-5">
                            LeetCode solutions
                            <span slot="end" class="text-sm font-normal text-stone-500 dark:text-stone-400">
                                {solvedProblems.length} solved
                            </span>
                        </ArrowLink>
                    </li>
                    <li>
                        <ArrowLink href={PAGE_METADATA.advent.url} class="py-5">
                            Advent of Code
                            <span slot="end" class="text-sm font-normal text-stone-500 dark:text-stone-400">
                                {adventChallenges.length} notes
                            </span>
                        </ArrowLink>
                    </li>
                </ul>
            </section>

            <div class="grid gap-12 lg:grid-cols-2">
                <section class="animate space-y-6 rounded-xl border border-stone-300 bg-stone-100/70 p-5 dark:border-stone-700 dark:bg-stone-900/30 sm:p-6">
                    <AnchorHeading level={2} id="leetcode-topics" class="text-xl font-semibold text-stone-950 dark:text-stone-50">
                        LeetCode topics
                    </AnchorHeading>
                    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                        {
                            difficultyCounts.map((difficulty) => (
                                <StatCard
                                    href={`${PAGE_METADATA.leetcode.url}#${difficulty.name.toLowerCase()}`}
                                    label={difficulty.name}
                                    value={difficulty.count}
                                />
                            ))
                        }
                    </div>
                    <ul class="space-y-3">
                        {
                            categories.map((category) => (
                                <li>
                                    <ArrowLink href={`${PAGE_METADATA.leetcode.url}/${category.name}`}>
                                        {category.name}
                                        <span slot="end" class="text-sm font-normal text-stone-500 dark:text-stone-400">
                                            {category.count} solved
                                        </span>
                                    </ArrowLink>
                                </li>
                            ))
                        }
                    </ul>
                </section>

                <section class="animate space-y-6 rounded-xl border border-stone-300 bg-stone-100/70 p-5 dark:border-stone-700 dark:bg-stone-900/30 sm:p-6">
                    <AnchorHeading level={2} id="advent-progress" class="text-xl font-semibold text-stone-950 dark:text-stone-50">
                        Advent progress
                    </AnchorHeading>
                    <p class="max-w-md font-serif leading-7 text-stone-600 dark:text-stone-300">
                        Implementation notes by event year. Puzzle text, examples,
                        and inputs remain on the official site.
                    </p>
                    <ul class="space-y-3">
                        {
                            adventYears.map((entry) => (
                                <li>
                                    <ArrowLink href={`${PAGE_METADATA.advent.url}/${entry.year}`}>
                                        {entry.year}
                                        <span slot="end" class="text-sm font-normal text-stone-500 dark:text-stone-400">
                                            {entry.count}/25 completed
                                        </span>
                                    </ArrowLink>
                                </li>
                            ))
                        }
                    </ul>
                </section>
            </div>
        </div>
    </Container>
</PageLayout>
