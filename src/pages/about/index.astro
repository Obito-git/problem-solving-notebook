---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import Link from "@components/Link.astro";
import { SITE, SOCIALS, PAGE_METADATA } from "@const/global";
---

<PageLayout
    title={PAGE_METADATA.about.title}
    description={PAGE_METADATA.about.description}
>
    <Container>
        <div class="space-y-16">
            <section class="animate max-w-2xl space-y-5">
                <p class="font-semibold text-black dark:text-white">About</p>
                <h1 class="text-4xl font-semibold tracking-tight text-black dark:text-white">
                    A working notebook for problem solving.
                </h1>
                <article class="space-y-4">
                    <p>
                        I am Anton, a software developer from Ukraine, based in
                        France. This site is where I publish my
                        <Link
                            href="https://leetcode.com/"
                            aria-label="LeetCode website"
                            external
                        >
                        LeetCode
                        </Link>
                        and Advent of Code solutions in Rust.
                    </p>
                    <p>
                        Each note records more than a final answer: tests,
                        alternative approaches, complexity, and diagrams when
                        they make the idea clearer. It is a place to revisit
                        patterns and make the reasoning durable.
                    </p>
                    <p>
                        The content is intentionally small and practical. New
                        solved problems are added as complete notes, not as a
                        feed of unfinished drafts.
                    </p>
                </article>
            </section>

            <section class="animate space-y-4">
                <h2 class="font-semibold text-black dark:text-white">
                    Let's connect
                </h2>
                <p>
                    Find me on social media or send an email about a solution.
                </p>
                <ul class="flex flex-wrap gap-2">
                    {
                        SOCIALS.map((social) => (
                            <li class="flex gap-x-2 text-nowrap">
                                <Link
                                    href={social.href}
                                    external
                                    aria-label={`${SITE.name} on ${social.name}`}
                                >
                                    {social.name}
                                </Link>
                                <span>{"/"}</span>
                            </li>
                        ))
                    }
                    <li class="line-clamp-1">
                        <Link
                            href={`mailto:${SITE.email}`}
                            aria-label={`Email ${SITE.name}`}
                        >
                            {SITE.email}
                        </Link>
                    </li>
                </ul>
            </section>
        </div>
    </Container>
</PageLayout>
