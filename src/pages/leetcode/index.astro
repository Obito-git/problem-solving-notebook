---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Search from "astro-pagefind/components/Search";
import { ContentCollection, PAGE_METADATA } from "@const/global";
import { ProblemDifficulty } from "@const/leetcode";
import ProblemArrowCard from "@components/leetcode/ProblemArrowCard.astro";
import { mapToProblemCardEntry } from "@content/config";

const allProblems: CollectionEntry<typeof ContentCollection.LEETCODE>[] = (
    await getCollection(ContentCollection.LEETCODE)
).filter((problem) => !problem.data.draft);

type ProblemsByDifficulty = {
    [difficulty: string]: CollectionEntry<ContentCollection.LEETCODE>[];
};

const problemsByDifficulty = allProblems.reduce(
    (problems, problem) => {
        const difficulty = problem.data.difficulty;
        if (!problems[difficulty]) {
            problems[difficulty] = [];
        }
        problems[difficulty].push(problem);
        return problems;
    },
    {} as ProblemsByDifficulty,
);

const difficulties = Object.values(ProblemDifficulty).filter(
    (difficulty) => problemsByDifficulty[difficulty]?.length,
);
---

<PageLayout
    title={PAGE_METADATA.leetcode.title}
    description={PAGE_METADATA.leetcode.description}
>
    <Container>
        <div class="space-y-10">
            <h1
                class="animate font-semibold text-black dark:text-white text-3xl"
            >
                Solved problems
            </h1>
            <div class="animate">
                <Search
                    id="search"
                    className="pagefind-ui"
                    uiOptions={{ showImages: false }}
                />
                <div
                    class="border-l-4 pl-4 mt-2 text-sm font-semibold text-black dark:text-white border-red-500 dark:border-yellow-500"
                >
                    <p>Search across the published solution notes.</p>
                </div>
            </div>
            <div class="animate space-y-4">
                {
                    difficulties.map((difficulty) => {
                        const problems = problemsByDifficulty[difficulty].sort(
                            (left, right) => left.data.num - right.data.num,
                        );
                        return (
                            <section
                                id={difficulty.toLowerCase()}
                                class="animate space-y-4"
                            >
                                <h2 class="font-semibold text-black dark:text-white">
                                    {difficulty}
                                </h2>
                                <div>
                                    <ul class="flex flex-col gap-4">
                                        {problems.map((problem) => (
                                            <li data-key={problem.slug}>
                                                <ProblemArrowCard
                                                    entry={mapToProblemCardEntry(
                                                        problem,
                                                    )}
                                                />
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            </section>
                        );
                    })
                }
            </div>
        </div>
    </Container>
</PageLayout>
