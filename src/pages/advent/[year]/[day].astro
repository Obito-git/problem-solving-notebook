---
import { type CollectionEntry, getCollection, render } from "astro:content";
import type { MarkdownHeading } from "astro";
import ChallengeHeader from "@components/advent/ChallengeHeader.astro";
import NotePage from "@components/NotePage.astro";
import TableOfContents from "@components/leetcode/TableOfContents.astro";
import { ContentCollection, PAGE_METADATA } from "@const/global";

export async function getStaticPaths() {
  const challenges = (await getCollection(ContentCollection.ADVENT)).filter(
    (challenge) => !challenge.data.draft,
  );
  const headings = await Promise.all(
    challenges.map(async (challenge) => (await render(challenge)).headings),
  );
  return challenges.map((challenge, index) => ({
    params: {
      year: String(challenge.data.year),
      day: String(challenge.data.day),
    },
    props: { ...challenge, headings: headings[index] },
  }));
}

type Props = CollectionEntry<ContentCollection.ADVENT> & {
  headings: MarkdownHeading[];
};

const challenge = Astro.props as Props;
const { Content } = await render(challenge);
---

<NotePage
  title={challenge.data.title}
  description={`Rust notes for Advent of Code ${challenge.data.year}, day ${challenge.data.day}: ${challenge.data.title}.`}
  backHref={`${PAGE_METADATA.advent.url}/${challenge.data.year}`}
  backLabel={`Back to ${challenge.data.year}`}
>
  <ChallengeHeader slot="header" {...challenge.data} />
  {
    challenge.headings.length > 0 ? (
      <TableOfContents slot="toc" headings={challenge.headings} />
    ) : null
  }
  <Content />
</NotePage>
