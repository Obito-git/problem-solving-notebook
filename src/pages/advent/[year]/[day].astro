---
import { type CollectionEntry, getCollection } from "astro:content";
import type { MarkdownHeading } from "astro";
import BackToPrev from "@components/BackToPrev.astro";
import Container from "@components/Container.astro";
import ChallengeHeader from "@components/advent/ChallengeHeader.astro";
import TableOfContents from "@components/leetcode/TableOfContents.astro";
import { ContentCollection, PAGE_METADATA } from "@const/global";
import PageLayout from "@layouts/PageLayout.astro";

export async function getStaticPaths() {
  const challenges = (await getCollection(ContentCollection.ADVENT)).filter(
    (challenge) => !challenge.data.draft,
  );
  const headings = await Promise.all(
    challenges.map(async (challenge) => (await challenge.render()).headings),
  );
  return challenges.map((challenge, index) => ({
    params: {
      year: String(challenge.data.year),
      day: String(challenge.data.day),
    },
    props: { ...challenge, headings: headings[index] },
  }));
}

type Props = CollectionEntry<ContentCollection.ADVENT> & {
  headings: MarkdownHeading[];
};

const challenge = Astro.props as Props;
const { Content } = await challenge.render();
---

<PageLayout title={challenge.data.title} description={`Rust notes for Advent of Code ${challenge.data.year}, day ${challenge.data.day}: ${challenge.data.title}.`}>
  <Container>
    <div class="animate">
      <BackToPrev href={`${PAGE_METADATA.advent.url}/${challenge.data.year}`}>
        Back to {challenge.data.year}
      </BackToPrev>
    </div>
    <article class="animate">
      <ChallengeHeader {...challenge.data} />
      {
        challenge.headings.length > 0 ? (
          <TableOfContents headings={challenge.headings} />
        ) : null
      }
      <Content />
    </article>
  </Container>
</PageLayout>
